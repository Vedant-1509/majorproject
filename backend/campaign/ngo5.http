  "endDate": "2026-05-15T00:00:00.000Z",
  "address": {
    "city": "Navi Mumbai",
    "state": "Maharashtra",
    "country": "India",
    "landmark": "Vashi Toll Naka Base"
  },
  "monetary": {
    "targetAmount": 150000,
    "minDonation": 200
  }
}