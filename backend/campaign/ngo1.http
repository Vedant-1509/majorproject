### Create Profile
POST http://localhost:5000/api/v2/create-profile
Content-Type: application/json
Authorization: Bearer {{Token1}}

{
  "description": "Dedicated to urban afforestation and waste management in the Thane district.",
  "address": {
    "street": "45 Pokhran Road",
    "city": "Thane",
    "state": "Maharashtra",
    "country": "India",
    "zip": "400601"
  },
  "phone": "9876543211",
  "registrationNumber": "URN-THN-001",
  "mission": "Making Thane a greener, cleaner city.",
  "focusAreas": ["Environment", "Waste Management"],
  "socialLinks": {
    "website": "https://greenearththane.org"
  },
  "preferences": {
    "acceptVolunteers": true,
    "acceptDonations": true
  },
  "urnNumber": "URN-THN-001"
}



### Campaign 1: Yeoor Hills Clean-up (Volunteer)
POST {{BaseURL}}/create-campaign
Authorization: Bearer {{Token1}}
Content-Type: application/json

{
  "title": "Yeoor Hills Plastic Clean-up Drive",
  "description": "Join us for a weekend drive to clear plastic waste from the Yeoor Hills forest area.",
  "category": "Environment & Cleanliness",
  "campaignType": "VOLUNTEER",
  "startDate": "2026-04-10T00:00:00.000Z",
  "endDate": "2026-04-12T00:00:00.000Z",
  "address": {
    "city": "Thane",
    "state": "Maharashtra",
    "country": "India",
    "landmark": "Yeoor Hills Main Gate"
  },
  "volunteer": {
    "volunteersRequired": 50,
    "rolesNeeded": ["Clean-up Crew", "Team Coordinator"]
  }
}

### Campaign 2: Tree Plantation Drive (Monetary)
POST {{BaseURL}}/create-campaign
Authorization: Bearer {{Token1}}
Content-Type: application/json

{
  "title": "10,000 Trees for Thane",
  "description": "Fundraising to procure saplings and organic fertilizer for our monsoon plantation drive.",
  "category": "Afforestation & Tree Plantation",
  "campaignType": "MONETARY",
  "startDate": "2026-05-01T00:00:00.000Z",
  "endDate": "2026-06-15T00:00:00.000Z",
  "address": {
    "city": "Thane",
    "state": "Maharashtra",
    "country": "India",
    "landmark": "Ghodbunder Road"
  },
  "monetary": {
    "targetAmount": 250000,
    "minDonation": 500
  }
}

