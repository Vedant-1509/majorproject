  "urnNumber": "URN-RGD-003"
}

 


### Campaign 1: Cyclone Preparedness Kits (Monetary)
POST {{baseUrl}}/create-campaign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Emergency Cyclone Kits for Fishermen",
  "description": "Funding emergency kits containing torches, radios, and first-aid for fishing families.",
  "category": "Disaster Relief",
  "campaignType": "MONETARY",
  "startDate": "2026-04-01T00:00:00.000Z",
  "endDate": "2026-05-25T00:00:00.000Z",
  "address": {
    "city": "Alibaug",
    "state": "Maharashtra",
    "country": "India",
    "landmark": "Alibaug Beach"
  },
  "monetary": {
    "targetAmount": 500000,
    "minDonation": 500
  }
}

### Campaign 2: Beach Clean-up Campaign (Volunteer)
POST {{baseUrl}}/create-campaign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Murud Beach Mega Clean-up",
  "description": "Need volunteers to help clear plastic and fishing net debris from the coastline.",
  "category": "Environment & Cleanliness",
  "campaignType": "VOLUNTEER",
  "startDate": "2026-04-18T00:00:00.000Z",
  "endDate": "2026-04-19T00:00:00.000Z",
  "address": {
    "city": "Murud",
    "state": "Maharashtra",
    "country": "India",
    "landmark": "Murud Janjira Beach Area"
  },
  "volunteer": {
    "volunteersRequired": 100,
    "rolesNeeded": ["Volunteer Worker"]
  }
}

