Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Keep Our Animal Ambulance Running",
  "description": "Funding required for fuel, maintenance, and medical supplies for our 24/7 rescue ambulance.",
  "category": "Emergency Medical Response",
  "campaignType": "MONETARY",
